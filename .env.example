# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── PocketFi ────────────────────────────────────────────────────────────────
# Found in: PocketFi Dashboard → API Keys
# Public key is safe to expose to the browser (used to initialize transactions)
# Secret key must NEVER go in the frontend — set it as a Supabase Secret only
VITE_POCKETFI_PUBLIC_KEY=your-pocketfi-public-key-here
