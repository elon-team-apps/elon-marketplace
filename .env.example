# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_FIVESIM_API_KEY=your-5sim-api-key-here

# ─── PocketFi ────────────────────────────────────────────────────────────────
# Found in: PocketFi Dashboard → API Keys
#
# POCKETFI_SECRET_KEY is used by the /api/pay Vercel serverless function only.
# It must be added to Vercel → Project Settings → Environment Variables.
# NEVER prefix it with VITE_ — that would expose it to the browser bundle.
POCKETFI_SECRET_KEY=your-pocketfi-secret-key-here
